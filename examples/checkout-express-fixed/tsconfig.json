{
  // aliases resolvidos pelo grafo do ShielDepy (paths/baseUrl)
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
  },
  "include": ["src", "chaos", "shieldepy.chaos.config.ts", "vitest.config.ts"],
}
