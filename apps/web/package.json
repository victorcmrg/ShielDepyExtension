{
  "name": "@shieldepy/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Site + portal em React (Vite): landing, login e portal. A API fica em apps/api.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && vite build --ssr src/landing/prerender.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "npm run build && npm start -w @shieldepy/api",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.3"
  }
}
