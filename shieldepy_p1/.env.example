# Usado pela CLI (`npm run cli`) e pela web (`npm run web`). A extensão guarda as chaves no Secret Storage.
# Sem nenhuma chave, tudo roda em modo offline (ciclos e colisões continuam provados).
ANTHROPIC_API_KEY=
# SHIELDEPY_FAST_MODEL=claude-haiku-4-5-20251001
# SHIELDEPY_DEEP_MODEL=claude-haiku-4-5-20251001
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# PORT=3000
# DATABASE_URL=postgres://user:pass@localhost:5432/db

# --- Autenticação / multi-tenant (apps/web/src/auth) --------------------------

# E-mail que vira admin automaticamente (gate de /api/admin/*). Obrigatório antes
# de rodar `npm run bootstrap -w @shieldepy/web`.
ADMIN_EMAIL=

# Base pública usada para montar os redirect_uri do OAuth (sem barra no final).
# Em dev: http://localhost:3000
OAUTH_REDIRECT_BASE=http://localhost:3000

# OAuth do Google — criar em https://console.cloud.google.com/apis/credentials
# (Web application), registrando {OAUTH_REDIRECT_BASE}/api/auth/oauth/google/callback
# como redirect URI autorizado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth do GitHub — criar em https://github.com/settings/developers (OAuth Apps).
# GitHub só aceita 1 callback URL por app: crie um app separado para dev e outro
# para produção, cada um com {OAUTH_REDIRECT_BASE}/api/auth/oauth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Authority usada para montar o vscode://<authority>/callback do device-flow.
# Padrão já bate com o publisher.name da extensão (shieldepy.shieldepy).
# EXTENSION_URI_AUTHORITY=shieldepy.shieldepy

# Só em desenvolvimento sem HTTPS real: derruba o flag "Secure" do cookie de sessão.
# NÃO defina isso em produção. (Localhost já é tratado como contexto seguro pelos
# navegadores modernos, então normalmente nem essa flag é necessária.)
# DEV_INSECURE_COOKIES=1
