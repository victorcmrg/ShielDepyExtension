{
  "name": "shieldepy-p1",
  "private": true,
  "type": "module",
  "description": "ShielDepy (grafo estrutural + Tree-sitter) fundido com o Grafo de Interações (colisões entre regras reativas).",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "cli": "npm start -w @shieldepy/cli --",
    "web": "npm start -w @shieldepy/web",
    "build:vscode": "npm run build -w shieldepy",
    "package:vscode": "npm run package -w shieldepy"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
