{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Executar Extensão (ShielDepy)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/apps/vscode", "${workspaceFolder}/examples"],
      "outFiles": ["${workspaceFolder}/apps/vscode/dist/**/*.js"],
      "preLaunchTask": "shieldepy: watch"
    }
  ]
}
