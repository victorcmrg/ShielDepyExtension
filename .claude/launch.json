{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "shieldepy-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start",
        "-w",
        "@shieldepy/api"
      ],
      "port": 3001
    },
    {
      "name": "shieldepy-web-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@shieldepy/web"
      ],
      "port": 5173
    },
    {
      "name": "shieldepy-landing-build",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "exec",
        "-w",
        "@shieldepy/web",
        "--",
        "vite",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "shieldepy-prod-check",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start",
        "-w",
        "@shieldepy/api"
      ],
      "port": 3002,
      "env": {
        "PORT": "3002",
        "SHIELDEPY_DATA_DIR": "C:\\Users\\VctrCmrg\\AppData\\Local\\Temp\\shieldepy-prod-check"
      }
    }
  ]
}
